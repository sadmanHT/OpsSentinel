OPSSENTINEL_ENVIRONMENT=development
OPSSENTINEL_LOG_LEVEL=INFO
OPSSENTINEL_DATABASE_URL=postgresql+psycopg://opssentinel:opssentinel@localhost:5432/opssentinel
OPSSENTINEL_REDIS_URL=redis://localhost:6379/0
OPSSENTINEL_LLM_PROVIDER=local
OPSSENTINEL_LLM_MODEL=local-placeholder
OPSSENTINEL_MAX_STEPS=20
OPSSENTINEL_MAX_TOOL_CALLS=15
OPSSENTINEL_RANDOM_SEED=42
OPSSENTINEL_LANGFUSE_ENABLED=false
OPSSENTINEL_LANGFUSE_HOST=http://localhost:3000
OPSSENTINEL_OTEL_ENABLED=false
